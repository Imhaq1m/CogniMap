# CogniMap — supervisor machine key setup (S1, copy to .env, never commit keys)
# File: repo-root .env (gitignored via .gitignore `.env`). Backend loads via
# python-dotenv + os.environ only. No keys in repo. CI green with no keys
# (live paths fall back to stub with mode=stub + warning).
#
# cp .env.example .env   # then fill real keys on the demo machine only

# LlamaParse (Parse API v2, tier agentic default, agentic_plus for complex)
LLAMA_CLOUD_API_KEY=
LLAMA_TIER=agentic

# S2h mixed chain (grill G-Route): links route BY MODEL ID, free-first (G3).
# Groq serves normal clicks; DeepSeek answers when Groq stumbles (429/5xx).
# Reorder/extend to change routing; drop the paid id for single-provider mode.
LLM_MODELS=qwen/qwen3.8-27b,deepseek-flash

# Groq — free tier, qwen/qwen3.8-27b (first link)
GROQ_API_KEY=
# GROQ_BASE_URL=  # default https://api.groq.com/openai/v1

# DeepSeek — pay-as-you-go failover link (second)
# S2g+: pinned deepseek-flash; thinking is disabled in code (effort=low does
# not stop thinking on this model — probe recorded in the tracker).
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=  # default https://api.deepseek.com

# Optional limits (S6 defaults shown). Groq answers in <1s, so the 30s code
# default works; LLM_TIMEOUT_S is only a hang guard.
# MAX_PDF_BYTES=20971520
# LLAMA_PAGE_CAP=50
# LLM_TIMEOUT_S=90
# PARSE_TIMEOUT_S=120

# Health check: GET /api/health -> {ok, step, llama: live|stub, llm: live|stub, llm_model}
# Demo runs:
#  keyless:  pytest Build/tests  (stub, mode=stub + "Demo mode (stubbed) ..." warning)
#  live:     set keys in .env, POST /upload-pdf with real PDF, POST /extract -> mode=live
#  fallback: bad/missing key or transient 429/5xx, POST /extract -> mode=stub +
#            fallback_reason logged (never 502)
