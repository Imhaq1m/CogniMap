# CogniMap — supervisor machine key setup (S1, copy to .env, never commit keys)
# File: repo-root .env (gitignored via .gitignore `.env`). Backend loads via
# python-dotenv + os.environ only. No keys in repo. CI green with no keys
# (live paths fall back to stub with mode=stub + warning).
#
# cp .env.example .env   # then fill real keys on the demo machine only

# LlamaParse (Parse API v2, tier agentic default, agentic_plus for complex)
LLAMA_CLOUD_API_KEY=
LLAMA_TIER=agentic

# Groq (S2c default: free tier, LPU-fast, OpenAI-compatible) — qwen3.8-27b
LLM_PROVIDER=groq
GROQ_API_KEY=
# GROQ_BASE_URL=  # default https://api.groq.com/openai/v1
# LLM_MODELS=qwen/qwen3.8-27b

# Archived provider (kept selectable, not default): Gemini chain
# gemini-3.8-flash -> gemini-3.7-flash -> gemini-3.6-flash -> stub
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=
# GEMINI_API_KEY=   # alias accepted, GOOGLE_API_KEY wins when both set
# LLM_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# Optional limits (S6 defaults shown)
# MAX_PDF_BYTES=20971520
# LLAMA_PAGE_CAP=50
# LLM_TIMEOUT_S=30
# PARSE_TIMEOUT_S=120

# Health check: GET /api/health -> {ok, step, llama: live|stub, llm: live|stub, llm_model}
# Demo runs:
#  keyless:  pytest Build/tests  (stub, mode=stub + "Demo mode (stubbed) ..." warning)
#  live:     set keys in .env, POST /upload-pdf with real PDF, POST /extract -> mode=live
#  fallback: set bad key, POST /extract -> mode=stub + fallback_reason logged (never 502)
